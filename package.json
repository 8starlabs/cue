{
  "name": "8starlabs-cue-workspace",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:docs": "pnpm --filter cue-docs dev",
    "build:docs": "pnpm --filter cue-docs build",
    "check:docs": "pnpm --filter cue-docs check",
    "build:cue": "pnpm --filter cue build",
    "build:app": "pnpm --filter cue build:app",
    "version:check": "node scripts/check-release-version.mjs",
    "version:cue": "node scripts/set-cue-version.mjs",
    "changelog:new": "node scripts/changelog.mjs new",
    "changelog:check": "node scripts/changelog.mjs check",
    "release:cue": "bash scripts/package-cue-release.sh",
    "release:publish": "bash scripts/publish-cue-release.sh",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
