{
  "name": "8starlabs-cue-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:docs": "pnpm --filter cue-docs dev",
    "build:docs": "pnpm --filter cue-docs build",
    "check:docs": "pnpm --filter cue-docs check",
    "build:cue": "pnpm --filter cue build",
    "build:app": "pnpm --filter cue build:app",
    "release:cue": "bash scripts/package-cue-release.sh"
  }
}
